# Copy to .env and adjust. Every value has a working default for local use,
# so `docker compose up --build` works even without a .env file.

# --- Postgres (used by the db container) ---
POSTGRES_USER=ajaia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ajaia
# Host port the db container is published on.
DB_PORT=5432

# --- App ---
# Used by `npm run dev`, `npm run migrate`, `npm run seed` and `npm test` on your machine.
# (Inside Docker, compose builds this itself with host `db`.)
DATABASE_URL=postgres://ajaia:change-me@localhost:5432/ajaia

# Secret used to sign login session tokens (JWT, HS256). 16+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Set to true when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=false

# Seed alice@ajaia.test and bob@ajaia.test on container startup. Turn off in production.
SEED_DEMO_DATA=true

# Host port for the web app.
APP_PORT=3000
